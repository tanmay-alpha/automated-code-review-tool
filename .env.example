# =====================================================
# automated-code-review-tool — .env.example
# Copy to .env and fill in real values.
# NEVER commit .env. It is .gitignored.
# =====================================================

# -----------------------------------------------------
# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:8080/api/auth/callback
# -----------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# -----------------------------------------------------
# JWT signing key (access tokens + refresh tokens)
# Generate: openssl rand -base64 64
# -----------------------------------------------------
JWT_SECRET=generate_via_openssl_rand_base64_64

# -----------------------------------------------------
# AES encryption key for DB fields
# Encrypts: GitHub OAuth tokens, webhook secrets
# Generate: openssl rand -base64 32
# Must be exactly 32 bytes when decoded (base64-decoded)
# -----------------------------------------------------
ENCRYPTION_KEY=generate_via_openssl_rand_base64_32

# -----------------------------------------------------
# HuggingFace (for private model access + pushing fine-tuned model)
# Get token: https://huggingface.co/settings/tokens
# -----------------------------------------------------
HF_TOKEN=hf_your_huggingface_token

# ML model name on HuggingFace Hub (private repo after fine-tuning)
ML_MODEL_NAME=tanmay-alpha/automated-code-review-tool-codebert

# -----------------------------------------------------
# ML Worker (FastAPI) — internal secret
# Shared between Spring Boot and FastAPI via header
# Spring Boot sends it; FastAPI validates it
# Generate: openssl rand -hex 32
# -----------------------------------------------------
ML_WORKER_SECRET=generate_via_openssl_rand_hex_32

# FastAPI URL (used by Spring Boot WebClient)
ML_WORKER_URL=http://localhost:8000

# -----------------------------------------------------
# Next.js (apps/web)
# -----------------------------------------------------
# Used by NextAuth for CSRF / session token signing
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=generate_via_openssl_rand_base64_32

# Public URL of the Spring Boot API (browser-visible)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public URL of the Next.js app itself
NEXTAUTH_URL=http://localhost:3000

# Local Docker uses HTTP; production must set this to true behind HTTPS.
COOKIE_SECURE=false

# Public API origin and webhook endpoint. Override the webhook URL with an
# HTTPS tunnel when exercising GitHub webhooks against the local stack.
APP_BASE_URL=http://localhost:8080
WEBHOOK_CALLBACK_URL=http://localhost:8080/api/webhook/github

# -----------------------------------------------------
# Database (PostgreSQL)
# Used by Spring Boot. For local non-Docker dev only.
# In Docker Compose, overridden by service-level env vars.
# -----------------------------------------------------
DATABASE_URL=postgresql://automated-code-review-tool:automated-code-review-tool_local@localhost:5432/automated-code-review-tool

# Direct JDBC vars (used by Spring Boot application.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/automated-code-review-tool
SPRING_DATASOURCE_USERNAME=automated-code-review-tool
SPRING_DATASOURCE_PASSWORD=automated-code-review-tool_local

# -----------------------------------------------------
# Supabase PostgreSQL (Cloud / Production / Render)
# Obtain from Supabase: Project Settings -> Database -> Connection string (JDBC)
# Direct connection (Port 5432):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Session pooler (Port 5432):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (Port 6543):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# -----------------------------------------------------

# Redis (Spring Boot)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
# Redis auth (used by docker-compose.yml --requirepass and SPRING_REDIS_PASSWORD).
# Generate: openssl rand -base64 32
REDIS_PASSWORD=generate_via_openssl_rand_base64_32
SPRING_REDIS_PASSWORD=generate_via_openssl_rand_base64_32

# -----------------------------------------------------
# Spring profile (dev | prod)
# -----------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------
# Local infrastructure defaults (used by docker-compose.yml)
# These match docker-compose.yml's hardcoded values.
# -----------------------------------------------------
POSTGRES_DB=automated-code-review-tool
POSTGRES_USER=automated-code-review-tool
POSTGRES_PASSWORD=automated-code-review-tool_local
