# Copy this file to .env for local development. Replace every change-me value.
# Never commit .env.

# GitHub OAuth application
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me

# Local-only development values. Generate new values before sharing a deployment.
# JWT_SECRET: openssl rand -base64 64
# ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=local-only-jwt-signing-key-change-before-sharing
ENCRYPTION_KEY=bG9jYWwtZGV2LWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=

# Internal API -> ML worker authentication
# ML_WORKER_SECRET: openssl rand -hex 32
ML_WORKER_SECRET=local-ml-worker-secret-change-me
ML_WORKER_URL=http://localhost:8000

# Production remains fallback-only unless an evaluated checkpoint is explicitly promoted.
MODEL_NAME=none
# Optional only for an explicitly configured private checkpoint.
HF_TOKEN=

# Browser and API origins
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:8080
WEBHOOK_CALLBACK_URL=http://localhost:8080/api/webhook/github
COOKIE_SECURE=false

# Direct Spring/PostgreSQL development
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/automated-code-review-tool
SPRING_DATASOURCE_USERNAME=automated-code-review-tool
SPRING_DATASOURCE_PASSWORD=automated-code-review-tool_local
SPRING_PROFILES_ACTIVE=dev

# Docker Compose datastore settings
POSTGRES_DB=automated-code-review-tool
POSTGRES_USER=automated-code-review-tool
POSTGRES_PASSWORD=automated-code-review-tool_local
REDIS_PASSWORD=automated-code-review-tool_local

# Direct Spring/Redis development
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=automated-code-review-tool_local

API_KEY_RPM=60
