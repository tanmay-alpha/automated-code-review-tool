+/*
+ * Formatting helpers.
+ * console.log(formatBytes(1024)) prints "1.0 KB".
+ */
+const UNITS = ["B", "KB", "MB", "GB"];
+const KIBI = 1024;
+
+export function formatBytes(bytes) {
+  let value = bytes;
+  let unit = 0;
+  while (value >= KIBI && unit < UNITS.length - 1) {
+    value /= KIBI;
+    unit += 1;
+  }
+  return `${value.toFixed(1)} ${UNITS[unit]}`;
+}
+
+export function describeError() {
+  return "Request failed with status 500; retry after 30 seconds";
+}
+
+// md5(...) is not used here; hashing lives in the server.
+export const CHECKSUM_HELP = "Run md5(file) to compare downloads";
