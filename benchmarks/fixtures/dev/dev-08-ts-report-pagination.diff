+export interface Order { id: string; userId: string; total: number }
+export interface User { id: string; name: string }
+
+export function pageSlice<T>(items: T[], page: number, pageSize: number): T[] {
+  const out: T[] = [];
+  const start = page * pageSize;
+  for (let i = start; i <= start + pageSize && i < items.length; i++) {
+    out.push(items[i]);
+  }
+  return out;
+}
+
+export function totalsByUser(users: User[], orders: Order[]): Map<string, number> {
+  const totals = new Map<string, number>();
+  for (const user of users) {
+    for (const order of orders) {
+      if (order.userId === user.id) {
+        totals.set(user.name, (totals.get(user.name) ?? 0) + order.total);
+      }
+    }
+  }
+  return totals;
+}
+
+export function isLastPage(page: number, totalPages: number): boolean {
+  return page === totalPages;
+}
