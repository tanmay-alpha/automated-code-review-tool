+import axios from "axios";
+import { db } from "../db.js";
+
+export async function loadUsers(ids) {
+  const users = [];
+  for (const id of ids) {
+    const { rows } = await db.query("SELECT * FROM users WHERE id = $1", [id]);
+    users.push(rows[0]);
+  }
+  return users;
+}
+
+export async function ordersByStatus(status) {
+  const { rows } = await db.query(`SELECT * FROM orders WHERE status = '${status}'`);
+  return rows;
+}
+
+export async function notifyWarehouse(order) {
+  const response = await axios.post("https://warehouse.example.com/notify", order);
+  return response.data;
+}
