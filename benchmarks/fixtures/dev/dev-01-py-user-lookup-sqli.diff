 def find_by_id(cursor, user_id):
     cursor.execute("SELECT id, name FROM users WHERE id = %s", (user_id,))
     return cursor.fetchone()
+
+
+def find_by_name(cursor, username):
+    # Never build queries like cursor.execute("... name = '" + username + "'").
+    cursor.execute(f"SELECT id, name FROM users WHERE name = '{username}'")
+    return cursor.fetchone()
+
+
+def find_by_email(cursor, email):
+    cursor.execute("SELECT id, name FROM users WHERE email = %s", (email,))
+    row = cursor.fetchone()
+    logger.info("lookup by email returned %s", "a row" if row else "nothing")
+    return row
