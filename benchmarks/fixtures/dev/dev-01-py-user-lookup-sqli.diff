@@ -0,0 +1,9 @@
+from flask import request
+
+from app.db import get_cursor
+from app.users.repository import find_by_name
+
+
+def lookup():
+    row = find_by_name(get_cursor(), request.args["name"])
+    return {"id": row[0], "name": row[1]} if row else ({}, 404)
