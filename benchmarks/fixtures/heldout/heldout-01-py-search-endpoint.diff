+import hashlib
+
+import requests
+from flask import request
+
+from app.db import get_cursor
+
+
+def search():
+    term = request.args.get("q", "")
+    cursor = get_cursor()
+    cursor.execute("SELECT id, title FROM posts WHERE title LIKE '%%%s%%'" % term)
+    rows = cursor.fetchall()
+    print("search", term, len(rows))
+    requests.post("https://analytics.example.com/events", json={"q": term})
+    return {"results": rows[:20]}
+
+
+def password_digest(password):
+    return hashlib.md5(password.encode()).hexdigest()
