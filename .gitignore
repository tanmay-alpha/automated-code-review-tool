# =====================================================
# automated-code-review-tool — .gitignore
# Covers: Java + Python + Node + .env + OS + IDE + Docker
# =====================================================

# -----------------------------------------------------
# Environment files (NEVER commit secrets)
# -----------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------
# General Build & Output Artifacts
# -----------------------------------------------------
build/
dist/
out/
target/
bin/
*.class
*.jar
*.war
*.ear
*.vsix
*.tsbuildinfo

# The GitHub Action must commit its self-contained runtime bundle.
!github-action/dist/

# -----------------------------------------------------
# Dependency Directories
# -----------------------------------------------------
node_modules/
.pnpm-store/
bun.lockb

# -----------------------------------------------------
# Java & IDEs (IntelliJ, Eclipse, VS Code)
# -----------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.cproject
.factorypath
.buildpath
.springBeans
.sts4-cache/
.vscode/
spring-boot-devtools.properties

# Local tool state
*.local.md
.claude/
.codex/
.cursor/
.gemini/
.chat/

# -----------------------------------------------------
# Python & ML Worker
# -----------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
env/
ENV/
.python-version
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.benchmarks/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pylint.d/
.ipynb_checkpoints/

# ML / Data / Model Artifacts
*.pt
*.pth
*.pkl
*.h5
*.onnx
*.safetensors
*.bin
*.npy
*.npz
*.parquet
.huggingface/
hf_cache/
mlruns/
wandb/
experiments/
checkpoints/
model-artifacts/
artifacts/

# Local training data
apps/ml-worker/training/data/

# -----------------------------------------------------
# Web / Next.js
# -----------------------------------------------------
.next/
next-env.d.ts
.vercel

# -----------------------------------------------------
# Docker & System Logs
# -----------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------
# OS-specific Files & Temp/Backups
# -----------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*~
.fuse_hidden*
.Trash-*
*.swp
*.swo
*.bak
*.tmp
*.orig
.local/
scratch/
*.scratch.*
